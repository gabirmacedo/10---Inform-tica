<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ativ4_Exe5"/>
        <attribute name="authors" value="mjoaol"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2024-10-16 11:13:11 "/>
        <attribute name="created" value="bWpvYW9sO0E0UzA5UFJPRjsyMDI0LTEwLTE2OyIwODo1NTozOSAiOzI0NTk="/>
        <attribute name="edited" value="bWpvYW9sO0E0UzA5UFJPRjsyMDI0LTEwLTE2OyIxMToxMzoxMSAiOzU7MjU0OQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="cont, soma, quantos, inicio" type="Integer" array="False" size=""/>
            <output expression="&quot;Quantos n&#250;meros quer somar?&quot;" newline="True"/>
            <input variable="quantos"/>
            <output expression="&quot;Quer come&#231;ar em que n&#250;mero?&quot;" newline="True"/>
            <input variable="inicio"/>
            <assign variable="soma" expression="0"/>
            <for variable="cont" start="inicio" end="inicio+quantos-1" direction="inc" step="1">
                <assign variable="soma" expression="soma + cont"/>
            </for>
            <output expression="&quot;A soma dos primeiros &quot; &amp; quantos &amp; &quot; n&#250;meros inteiros a partir do &quot; &amp; inicio &amp; &quot; &#233; &quot; &amp; soma" newline="True"/>
        </body>
    </function>
</flowgorithm>
